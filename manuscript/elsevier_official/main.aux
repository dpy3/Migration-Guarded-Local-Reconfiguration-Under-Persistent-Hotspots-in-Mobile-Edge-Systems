\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Formal 30-run means at the 5\% primary guard. ``Admitted'' and ``Rejected'' are mean task counts per slot (and sum to $N=180$). MigrationMB is the profile-derived migration-volume proxy defined in Section 3; it is not packet-level network traffic. Admission and rejection transitions are excluded from migration counts.}}{13}{table.3}\protected@file@percent }
\newlabel{tab:main-results}{{3}{13}{Formal 30-run means at the 5\% primary guard. ``Admitted'' and ``Rejected'' are mean task counts per slot (and sum to $N=180$). MigrationMB is the profile-derived migration-volume proxy defined in Section 3; it is not packet-level network traffic. Admission and rejection transitions are excluded from migration counts}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Formal audit of BudgetedLNS trial-level guard and final-repair overrides (30 runs per persistent-hotspot scenario, $N=180$, 200 slots, $\rho =0.05$, $B=9$). ``Repair overrides/run'' is the mean number of recorded final-repair override events per 200-slot run; ``maximum excess'' is the largest recorded $\max (0,\mathrm  {final\ migrations}-B)$ across the 30 runs.}}{13}{table.4}\protected@file@percent }
\newlabel{tab:guard-audit}{{4}{13}{Formal audit of BudgetedLNS trial-level guard and final-repair overrides (30 runs per persistent-hotspot scenario, $N=180$, 200 slots, $\rho =0.05$, $B=9$). ``Repair overrides/run'' is the mean number of recorded final-repair override events per 200-slot run; ``maximum excess'' is the largest recorded $\max (0,\mathrm {final\ migrations}-B)$ across the 30 runs}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces BudgetedLNS separates from the comparator methods in run-level service and migration outcomes. Columns show compute, link, and coupled persistent hotspots. Rows show (a) mean satisfaction, (b) total migrations on a logarithmic scale, and (c) the profile-derived migration-volume proxy. Faint points are individual formal runs; diamonds and whiskers are arithmetic means and deterministic 95\% bootstrap intervals. Each method--scenario cell contains 30 matched 200-slot runs at $N=180$ and the 5\% primary local-search guard. MigrationMB is a profile-derived volume proxy, not packet-level network traffic.}}{14}{figure.2}\protected@file@percent }
